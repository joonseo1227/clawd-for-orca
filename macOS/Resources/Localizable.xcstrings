{
  "sourceLanguage": "en",
  "strings": {
    "%@  finished %@": {
      "comment": "Agent name, then when it finished, e.g. just now or 3 min ago",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@  %2$@ 완료"
          }
        }
      }
    },
    "%@ ago": {
      "comment": "%@ is a duration, e.g. 3 min",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 전"
          }
        }
      }
    },
    "%@ · for %@": {
      "comment": "Agent name, then how long it has been waiting, e.g. 3 min",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@ 전부터"
          }
        }
      }
    },
    "%@ · just now": {
      "comment": "Agent that started waiting less than a minute ago",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 방금부터"
          }
        }
      }
    },
    "%lld done": {
      "comment": "Menu bar: agents that finished",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료 %lld"
          }
        }
      }
    },
    "%lld hr %lld min": {
      "comment": "Duration in hours and minutes",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld시간 %2$lld분"
          }
        }
      }
    },
    "%lld min": {
      "comment": "Duration in minutes",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld분"
          }
        }
      }
    },
    "%lld running": {
      "comment": "Menu bar: agents working",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 %lld"
          }
        }
      }
    },
    "%lld steps": {
      "comment": "Steps the agent took in one turn",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld step"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld steps"
                }
              }
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단계 %lld개"
          }
        }
      }
    },
    "%lld waiting": {
      "comment": "Menu bar: agents waiting for the user",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인 %lld"
          }
        }
      }
    },
    "%lld working": {
      "comment": "Number of agents working",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 중 %lld개"
          }
        }
      }
    },
    "+%lld more": {
      "comment": "More tools in a step summary, after the first three",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외 %lld개"
          }
        }
      }
    },
    "+%lld more · %@": {
      "comment": "More waiting agents, then the hint for the first one",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외 %1$lld개 더 · %2$@"
          }
        }
      }
    },
    "1. In Orca’s left sidebar, open **Orca Mobile**.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Orca 왼쪽 사이드바에서 **Orca 모바일**을 열어요."
          }
        }
      }
    },
    "2. Generate a QR code and click **Copy pairing code**.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2. QR 코드를 생성하고 **페어링 코드 복사**를 눌러요."
          }
        }
      }
    },
    "3. Paste it below.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 아래에 붙여 넣어요."
          }
        }
      }
    },
    "About": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정보"
          }
        }
      }
    },
    "All agents are resting": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 다 쉬고 있어요"
          }
        }
      }
    },
    "Allow": {
      "comment": "Permission dialog answer",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용"
          }
        }
      }
    },
    "Allow Clawd in System Settings > Login Items": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 > 로그인 항목에서 Clawd를 허용해 주세요"
          }
        }
      }
    },
    "Allow, then auto mode": {
      "comment": "Permission dialog answer: Claude Code’s “Yes, and switch to auto mode”",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용 후 자동 모드"
          }
        }
      }
    },
    "Already answered, so nothing was sent": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 처리된 요청이라 아무것도 보내지 않았어요"
          }
        }
      }
    },
    "Always": {
      "comment": "When to send system notifications",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항상"
          }
        }
      }
    },
    "Always allow": {
      "comment": "Permission dialog answer: allow and don’t ask again",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항상 허용"
          }
        }
      }
    },
    "An unofficial app, not affiliated with Anthropic or Stably AI.": {
      "comment": "Settings: note under About",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic, Stably AI와 관계없는 비공식 앱이에요."
          }
        }
      }
    },
    "Another app already uses this shortcut. Choose a different one.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱이 이미 쓰고 있는 단축키예요. 다른 조합을 골라 주세요."
          }
        }
      }
    },
    "Another app is using %@. You can change it in Settings.": {
      "comment": "%@ is a keyboard shortcut such as ⌥Space",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱이 %@를 쓰고 있어요. 설정에서 바꿀 수 있어요"
          }
        }
      }
    },
    "Answer the permission request in Orca": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca에서 권한 요청에 답해 주세요"
          }
        }
      }
    },
    "Answer with the buttons above or ⌘1–%lld": {
      "comment": "Shortcuts ⌘1 to ⌘n pick a permission answer",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위 버튼이나 ⌘1–%lld 키로 답해 주세요"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소"
          }
        }
      }
    },
    "Can’t find Orca": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca를 찾을 수 없어요"
          }
        }
      }
    },
    "Can’t find the Orca app": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca 앱을 찾을 수 없어요"
          }
        }
      }
    },
    "Can’t read the pairing code. Paste the code exactly as copied from Orca.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링 코드를 읽을 수 없어요. Orca에서 복사한 코드를 그대로 붙여 넣어 주세요."
          }
        }
      }
    },
    "Can’t read the terminal screen. If the terminal was closed, check in Orca.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널 화면을 읽을 수 없어요. 터미널이 닫혔다면 Orca에서 확인해 주세요."
          }
        }
      }
    },
    "Celebrate": {
      "comment": "Something Clawd does, in the Tricks menu",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "축하 파티"
          }
        }
      }
    },
    "Chat": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화"
          }
        }
      }
    },
    "Check for Updates…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트 확인…"
          }
        }
      }
    },
    "Check for updates automatically": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트 자동 확인"
          }
        }
      }
    },
    "Clawd %@ is available": {
      "comment": "%@ is a version such as 1.0.1",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clawd %@ 버전이 나왔어요"
          }
        }
      }
    },
    "Clawd Settings": {
      "comment": "Settings window title",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clawd 설정"
          }
        }
      }
    },
    "Clawd shows the coding agents running in Orca. Install Orca and it connects right away.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clawd는 Orca에서 실행 중인 코딩 에이전트를 보여줘요. Orca를 설치하면 바로 연결돼요."
          }
        }
      }
    },
    "Clawd watches the coding agents working in Orca and lets you know when they need an answer or finish. Click Clawd to start chatting.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca에서 일하는 코딩 에이전트를 지켜보다가 답이 필요하거나 일이 끝나면 알려 줘요. 클릭하면 바로 대화할 수 있어요."
          }
        }
      }
    },
    "Clawd will open when you log in": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인하면 Clawd가 같이 켜져요"
          }
        }
      }
    },
    "Click to change": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클릭해서 바꾸기"
          }
        }
      }
    },
    "Click to chat with your agents. Double-click to open Orca.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클릭하면 에이전트와 대화, 두 번 클릭하면 Orca 열기"
          }
        }
      }
    },
    "Click to keep talking": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클릭해서 이어서 말하기"
          }
        }
      }
    },
    "Click to update": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클릭해서 업데이트"
          }
        }
      }
    },
    "Click to view": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클릭해서 보기"
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫기"
          }
        }
      }
    },
    "Close chat": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화 닫기"
          }
        }
      }
    },
    "Code": {
      "comment": "Something Clawd does, in the Tricks menu",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코딩하기"
          }
        }
      }
    },
    "Connected to Orca": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca와 연결했어요"
          }
        }
      }
    },
    "Connecting to Orca…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca에 연결하는 중…"
          }
        }
      }
    },
    "Connection error": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 오류"
          }
        }
      }
    },
    "Couldn’t change the login item: %@": {
      "comment": "%@ is the system error message",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 항목을 바꾸지 못했어요: %@"
          }
        }
      }
    },
    "Couldn’t connect to Orca": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca와 연결하지 못했어요"
          }
        }
      }
    },
    "Couldn’t read the pairing from the keychain": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키체인에서 연결 정보를 읽지 못했어요"
          }
        }
      }
    },
    "Couldn’t save the pairing to the keychain": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 정보를 키체인에 저장하지 못했어요"
          }
        }
      }
    },
    "Couldn’t send": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보내지 못했어요"
          }
        }
      }
    },
    "Couldn’t send the answer. Open it in Orca to check": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응답을 보내지 못했어요. Orca에서 열어서 확인해 주세요"
          }
        }
      }
    },
    "Couldn’t send. Open it in Orca to check": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보내지 못했어요. Orca에서 열어서 확인해 주세요"
          }
        }
      }
    },
    "Couldn’t start the live connection to Orca": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca 실시간 연결을 시작하지 못했어요"
          }
        }
      }
    },
    "Couldn’t start the live connection to Orca: %@": {
      "comment": "%@ is an error message",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca 실시간 연결을 시작하지 못했어요: %@"
